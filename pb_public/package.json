{
  "name": "mediario",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "Catálogo multimédia pessoal source-available para uso não comercial.",
  "author": "Zubiaks <zubiaks@hotmail.com>",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit",
    "check": "npm audit --omit=dev && npm run type-check && npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/components/base/BasePagination.a11y.spec.ts src/components/live/ChannelEditDialog.a11y.spec.ts src/components/live/StreamLinkEditDialog.a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "pocketbase": "0.27.0",
    "vue": "3.5.42",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.14.1",
    "jsdom": "^29.1.1",
    "typescript": "5.9.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "3.3.13"
  }
}
