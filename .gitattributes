# Mediario - normalizacao de finais de linha
# O repositorio guarda o codigo em LF e os scripts Windows em CRLF.

* text=auto eol=lf

# Scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Codigo e configuracao web
*.vue text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.sql text eol=lf

# PocketBase
pb_migrations/** text eol=lf
pb_hooks/** text eol=lf

# Ficheiros binarios
